@model IEnumerable<AWWW_lab02_gr3.Models.Author>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Add">Create new</a>
</p>
@if(Model != null)
{
    @foreach (var item in Model)
    {
        <p>
            <b>ID: </b> @Html.DisplayFor(modelItem => item.Id)
        
            <b>Firstname:</b> @Html.DisplayFor(modelItem => item.FirstName)
        
            <b>Lastname:</b> @Html.DisplayFor(modelItem => item.LastName)
        </p>
    };
}