@model IEnumerable<AWWW_lab02_gr3.Models.Category>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<a asp-action="Add">Create new</a>
@if(Model != null)
{
    @foreach(var item in Model)
    {
        <p>
            <b>Id: </b>@Html.DisplayFor(modelItem => item.Id)
            <b>Name: </b>@Html.DisplayFor(modelItem => item.Name)
        </p>
    }
}