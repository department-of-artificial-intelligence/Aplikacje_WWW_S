@model IEnumerable<AWWW_lab02_gr3.Models.Tag>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<a asp-action="Add">Create new</a>
<div>
    @if(Model != null)
    {
        @foreach(var item in Model)
        {
            <p>
                <b>ID: </b> @Html.DisplayFor(modelItem => item.Id) <br />
                <b>Name: </b> @Html.DisplayFor(modelItem => item.Name)
            </p>
        }
    }
</div>

