@model AWWW_lab1_gr1.Models.Product
@using AWWW_lab1_gr1.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var tags = ViewBag.Tags as List<Tag> ?? new();
    var selectedTagIds = ViewBag.SelectedTagIds as HashSet<int> ?? new();
}

<h1>Edytuj produkt</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Kategoria</label>
        <select asp-for="CategoryId" class="form-select" asp-items="@(ViewBag.CategoryId as SelectList)"></select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Tagi</label>
        @if (!tags.Any())
        {
            <p class="text-muted">Brak tagow do przypisania.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-3">
                @foreach (var tag in tags)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="selectedTagsIds" value="@tag.Id" id="tag_@tag.Id" checked="@selectedTagIds.Contains(tag.Id)" />
                        <label class="form-check-label" for="tag_@tag.Id">@tag.Name</label>
                    </div>
                }
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Zapisz</button>
    <a asp-action="Index" class="btn btn-secondary">Powrot</a>
</form>
