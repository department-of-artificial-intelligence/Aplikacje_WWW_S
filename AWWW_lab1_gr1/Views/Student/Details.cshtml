@model AWWW_lab1_gr1.Models.Student

<h2>Szczegóły studenta</h2>

<dl>
    <dt>Imię - </dt>
    <dd>@Model.FirstName</dd>

    <dt>Nazwisko - </dt>
    <dd>@Model.LastName</dd>

    <dt>Numer indeksu - </dt>
    <dd>@Model.IndexNr</dd>

    <dt>Data urodzenia - </dt>
    <dd>@Model.DateOfBirth.ToShortDateString()</dd>

    <dt>Kierunek studiów -</dt>
    <dd>@Model.FieldOfStudy</dd>
</dl>

<a asp-controller="Student" asp-action="Index">Powrót do listy</a>