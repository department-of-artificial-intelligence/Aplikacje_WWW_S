@model IEnumerable<AWWW_lab1_gr1.Models.Student>


<p>
    @foreach (var student in Model){
        <ul>
            <li>
                <strong>Imię:</strong> @student.FirstName <br />
                <strong>Nazwisko:</strong> @student.LastName <br />
                <a asp-controller="Details" asp-action="Index" asp-route-id="@student.Id">Szczegóły</a>
            </li>
        </ul>
	}
</p>
