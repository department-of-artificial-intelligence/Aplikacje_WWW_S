@model AWWW_lab2.v2_gr1.Models.HomeViewModel

<h1>Strona główna</h1>

<p>Witamy na stronie głównej</p>

@if (Model?.Categories != null)
{
    <h2>Kategorie</h2>
    @foreach (var category in Model.Categories)
    {
        <div class="w3-card w3-margin">
            <header class="w3-container w3-blue">
                <h3>@category.Id</h3>
            </header>

            <div class="w3-container">
                <p>@category.Name</p>
                <p>
                    <a asp-controller="Article"
                       asp-action="Index"
                       asp-route-id="@category.Id">
                       Czytaj dalej
                    </a>
                </p>
            </div>
        </div>
    }
}

@if (Model?.Addresses != null)
{
    <h2>Adresy</h2>
    @foreach (var address in Model.Addresses)
    {
        <div class="w3-card w3-margin">
            <header class="w3-container w3-blue">
                <h3>@address.Id</h3>
            </header>

            <div class="w3-container">
                <p>@address.City</p>
                <p>@address.Street</p>
                <p>
                    <a asp-controller="Article"
                       asp-action="Index"
                       asp-route-id="@address.Id">
                       Czytaj dalej
                    </a>
                </p>
            </div>
        </div>
    }
}

@if (Model?.Tags != null)
{
    <h2>Tagi</h2>
    @foreach (var tag in Model.Tags)
    {
        <div class="w3-card w3-margin">
            <header class="w3-container w3-blue">
                <h3>@tag.Id</h3>
            </header>

            <div class="w3-container">
                <p>@tag.Name</p>
                <p>
                    <a asp-controller="Article"
                       asp-action="Index"
                       asp-route-id="@tag.Id">
                       Czytaj dalej
                    </a>
                </p>
            </div>
        </div>
    }
}