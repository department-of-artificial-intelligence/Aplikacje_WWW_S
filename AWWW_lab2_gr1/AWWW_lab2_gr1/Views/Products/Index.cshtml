@model List<AWWW_lab2_gr1.Models.Product>

<h2>Lista produktów</h2>

<a href="/Product/Create">Dodaj nowy produkt</a>

<table border="1">
    <thead>
        <tr>
            <th>Nazwa</th>
            <th>Cena</th>
            <th>Kategoria</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Price</td>
                <td>@p.Category?.Name</td>
            </tr>
        }
    </tbody>
</table>