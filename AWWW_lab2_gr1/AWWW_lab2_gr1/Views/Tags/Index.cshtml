@model IEnumerable<AWWW_lab2_gr1.Models.Tag>

<h2>Lista tagów</h2>

<a href="/Tags/Create">Dodaj nowy</a>

<table border="1">
    <tr>
        <th>Id</th>
        <th>Nazwa</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
        </tr>
    }
</table>