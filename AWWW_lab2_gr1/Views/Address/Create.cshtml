@using Microsoft.AspNetCore.Mvc.Rendering
@model AWWW_lab2_gr1.Models.Address

<h2>Dodaj Adres</h2>
<hr />

@if (ViewBag.Customers == null || ((SelectList)ViewBag.Customers).Count() == 0)
{
    <p>Brak klientów w bazie danych. Najpierw <a asp-controller="Customer" asp-action="Create">dodaj klienta</a>.</p>
}
else
{
    <form asp-action="Create">
        <div>
            <label asp-for="City">Miasto</label>
            <input asp-for="City" type="text" />
        </div>
        <div>
            <label asp-for="Street">Ulica</label>
            <input asp-for="Street" type="text" />
        </div>
        <div>
            <label asp-for="PostalCode">Kod pocztowy</label>
            <input asp-for="PostalCode" type="text" />
        </div>
        <div>
            <label asp-for="CustomerId">Klient</label>
            <select asp-for="CustomerId" asp-items="ViewBag.Customers"></select>
        </div>
        
        <div style="margin-top: 15px;">
            <input type="submit" value="Zapisz" class="my-btn" />
            <a asp-action="Index" class="my-btn">Powrót do listy</a>
        </div>
    </form>
}