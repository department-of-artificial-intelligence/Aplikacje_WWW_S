@model AWWW_lab2_gr1.Models.Address

<form asp-action="Create" method="post">
    <div>
        <label>Miasto</label>
        <input asp-for="City"/>
    </div>
    <br/>

    <div>
        <label>Ulica</label>
        <input asp-for="Street" />
    </div>
    <br />

    <div>
        <label>Kod pocztowy</label>
        <input asp-for="PostalCode" />
    </div>
    <br/>

    <button type="submit">Zapisz</button>
</form>
