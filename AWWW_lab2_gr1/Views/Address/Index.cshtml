@model List<AWWW_lab2_gr1.Models.Address>


<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Addresses</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Add New
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>Id</th>
                        <th>Postal code</th>
                        <th>City</th>
                        <th>Street</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var  address in Model)
                {
                    <tr>
                        <td>@address.Id</td>
                        <td>@(address.PostalCode ?? "-")</td>
                        <td>@address.City</td>
                        <td>@(address.Street ?? "-")</td>
                        <td class="justify-content-end d-flex">
                            <form asp-action="Update" asp-route-id="@address.Id">
                                <button class="btn btn-sm btn-outline-secondary me-2" type="submit">Edit</button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@address.Id" method="post"
                                onsubmit="return confirm('Are you sure you want to delete address @address.ToString()');">
                                <button class="btn btn-sm btn-danger me-2" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>