@model IEnumerable<AWWW_lab2_gr1.Models.Address>

<h2>Lista Adresów</h2>

<p>
    <a asp-action="Create" class="my-btn">Dodaj nowy adres</a>
</p>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Miasto</th>
            <th>Ulica</th>
            <th>Kod pocztowy</th>
            <th>ID Klienta</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td>@item.City</td>
            <td>@item.Street</td>
            <td>@item.PostalCode</td>
            <td>@item.CustomerId</td>
        </tr>
}
    </tbody>
</table>