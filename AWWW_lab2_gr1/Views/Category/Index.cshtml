@model IEnumerable<AWWW_lab2_gr1.Models.Category>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Lista Kategorii</h2>
    <a asp-action="Create" class="btn btn-primary">Dodaj nową kategorię</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nazwa</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
            </tr>
        }
    </tbody>
</table>