@model AWWW_lab2_gr1.Models.Order

<h2>Zmień Status Zamówienia #@Model.Id</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditStatus" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            
            <div class="mb-3">
                <label class="control-label">Wybierz nowy status</label>
                <select name="OrderStatusId" class="form-control" asp-items="ViewBag.Statuses"></select>
            </div>
            
            <button type="submit" class="btn btn-success">Zapisz zmianę</button>
            <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
        </form>
    </div>
</div>