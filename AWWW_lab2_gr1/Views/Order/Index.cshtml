@model ICollection<AWWW_lab2_gr1.Models.Order>

<div class="container">

    <div>
        <h2>Orders</h2>
        <a>Create New...</a>
    </div>
    <div>
        <table class="table">
            <thead>
                <th>Id</th>
                <th>Customer</th>
                <th>Status</th>
                <th>Created At</th>
                <th></th>
            </thead>
            <tbody>
                @foreach (AWWW_lab2_gr1.Models.Order order in @Model) {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.CustomerId</td>
                    <td>@order.Status.Status</td>
                    <td>@order.CreatedAt</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" class="btn btn-outline-secondary" asp-route-id="@order.Id">Details</a>
                            <a asp-action="Update" class="btn btn-primary" asp-route-id="@order.Id">Status</a>
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>