@model List<AWWW_lab2_gr1.Models.Order>

@{
    ViewData["Title"] = "Zamówienia";
}

<h1>Lista zamówień</h1>

<a asp-action="Create" class="btn btn-primary mb-3">+ Nowe zamówienie</a>

@if (Model.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Klient</th>
                <th>Status</th>
                <th>Data</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                        <td>@order.Customer.Name</td>
                    <td>
                        <span class="badge bg-info">@order.OrderStatus.Name</span>
                    </td>
                    <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">Szczegóły</a>
                        <form asp-action="Delete" asp-route-id="@order.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Czy na pewno usunąć?')">Usuń</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Brak zamówień</p>
}
