@model AWWW_lab2_gr1.Models.Product

<h2>Dodaj Produkt</h2>
<hr />

<form asp-action="Create">
    <div>
        <label asp-for="Name">Nazwa Produktu</label>
        <input asp-for="Name" type="text" required />
    </div>
    
    <div>
        <label asp-for="Price">Cena Produktu</label>
        <input asp-for="Price" type="number" step="0.01" required />
    </div>
    
    <div>
        <label asp-for="CategoryId">Kategoria</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" required>
            <option value="">Wybierz kategorię</option>
        </select>
    </div>

    <div>
        <label>Tagi</label>
        <select asp-for="Tags" asp-items="ViewBag.Tags" multiple size="5" name="selectedTagIds">
        </select>
        <small>Wybierz jeden lub więcej tagów (Ctrl/Shift do multiwyboru)</small>
    </div>
    
    <div>
        <input type="submit" value="Zapisz" class="my-btn" />
        <a asp-action="Index" class="my-btn">Powrót do listy</a>
    </div>
</form>