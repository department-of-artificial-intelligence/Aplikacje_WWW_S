@model AWWW_lab2_gr1.Models.Product

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white p-2">
        <h4>Add Product</h4>
    </div>
    <div class="card-body">
        <form asp-action="CreateConfirm" method="post">

            <div class="d-flex flex-column">
                <input asp-for="Id" type="hidden" value="@Model.Id"/>
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-input" value="@Model.Name"/>
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" type="numeric" class="form-input" value=@Model.Price/>
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select">
                    @foreach(AWWW_lab2_gr1.Models.Category cat in ViewBag.cats) {
                        if (Model.Category != null && cat.Id == Model.Category.Id)
                        {
                            <option value="@cat.Id" selected>@cat.Id @cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Id @cat.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="d-flex justify-content-around">
                <button class="btn btn-danger px-5" asp-controller="Product" asp-action="Index">Cancel</button>
                <button class="btn btn-primary px-5" type="submit">Create</button>
            </div>
        </form>
    </div>
</div>