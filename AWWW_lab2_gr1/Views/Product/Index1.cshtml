@model AWWW_lab2_gr1.Models.Product

<h2>Usuń Produkt</h2>
<h3 class="text-danger">Czy na pewno chcesz usunąć ten produkt?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nazwa</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        
        <dt class="col-sm-2">Cena</dt>
        <dd class="col-sm-10">@Model.Price.ToString("0.00") zł</dd>
        
        <dt class="col-sm-2">Kategoria</dt>
        <dd class="col-sm-10">@Model.Category?.Name</dd>
    </dl>
    
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Tak, Usuń</button>
        <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
    </form>
</div>