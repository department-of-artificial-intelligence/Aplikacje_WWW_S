@model IEnumerable<lab2.Models.Category>

@{
    ViewData["Title"] = "Lista kategorii";
}

<h1>Lista kategorii</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj kategorię</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nazwa</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
        </tr>
    }
    </tbody>
</table>