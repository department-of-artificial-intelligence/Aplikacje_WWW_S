@model ICollection<AWWW_lab2_gr3.Models.Author>

<h1>Autorzy</h1>

@if (Model != null)
{
    <table>
        <thead>
            <tr>
                <th>Imię</th>
                <th>Nazwisko</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var author in Model)
            {
                <tr>
                    <td>@author.FirstName</td>
                    <td>@author.LastName</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Ta strona nie ma jeszcze żadnych danych.</p>
}

<form asp-controller="Author" asp-action="Add" method="get">
    <button type="submit">Dodaj autora</button>
</form>