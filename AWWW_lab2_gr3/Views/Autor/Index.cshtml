@model IEnumerable<AWWW_lab2_gr3.Models.Author>

@{
    ViewData["Title"] = "Author Index";
}

<h1>Author</h1>

<table class="table">
    <thead>
        <tr>
            <th>Imie</th>
            <th>Nazwisko</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.FirstName</td>
                <td>@author.LastName</td>
                
            </tr>
        }
    </tbody>
</table>

<a asp-action="Add" class="btn btn-primary">Add New Author</a>