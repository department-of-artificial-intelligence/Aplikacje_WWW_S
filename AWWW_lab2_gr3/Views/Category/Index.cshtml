@model ICollection<AWWW_lab2_gr3.Models.Category>

<h1>Kategorie</h1>

@if (Model != null)
{
    <table>
        <thead>
            <tr>
                <th>Nazwa</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Ta strona nie ma jeszcze żadnych danych.</p>
}

<form asp-controller="Category" asp-action="Add" method="get">
    <button type="submit">Dodaj kategorię</button>
</form>