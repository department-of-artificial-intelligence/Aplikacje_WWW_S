@model List<AWWW_lab2_gr3.Models.Category>


<h1>Lista Kategori</h1>

<table class="table">
    <thead>
        <tr>
            <th>Nazwa kategori</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
              
            </tr>
        }
    </tbody>
</table>

<p>
    <a asp-action="Add" class="btn">Dodaj</a>
</p>