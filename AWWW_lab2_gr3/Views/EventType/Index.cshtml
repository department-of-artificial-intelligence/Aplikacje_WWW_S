@model ICollection<AWWW_lab2_gr3.Models.EventType>

<h1>Rodzaj wydarzenia</h1>

@if (Model != null)
{
    <table>
        <thead>
            <tr>
                <th>Nazwa</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var eventType in Model)
            {
                <tr>
                    <td>@eventType.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Ta strona nie ma jeszcze żadnych danych.</p>
}

<form asp-controller="eventType" asp-action="Add" method="get">
    <button type="submit">Dodaj rodzaj wydarzenia</button>
</form>