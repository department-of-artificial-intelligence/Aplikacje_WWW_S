@model List<AWWW_lab2_gr3.Models.EventType>


<h1>Lista Typow wydarzen</h1>

<table class="table">
    <thead>
        <tr>
            <th>Nazwa kategori</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var eventType in Model)
        {
            <tr>
                <td>@eventType.Name</td>

            </tr>
        }
    </tbody>
</table>

<p>
    <a asp-action="Add" class="btn btn-primary">Dodaj</a>
</p>