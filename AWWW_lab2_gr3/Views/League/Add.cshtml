@model AWWW_lab2_gr3.Models.League



<h1>Dodaj Lige</h1>


<form asp-action="Add" method="post" class="w3-container">
    <div class="form-group">
        <label asp-for="Name">Nazwa: </label>
        <input asp-for="Name" class="w3-input w3-border" />

    </div>
    <div class="form-group">
        <label asp-for="Country" >Kraj: </label>
        <input asp-for="Country" class="w3-input w3-border" />

    </div>
    <div class="form-group">
        <label asp-for="Level">Poziom: </label>
        <input asp-for="Level" class="w3-input w3-border" />

    </div>
    <div class="form-group">
        <input type="submit" value="Dodaj" class="btn btn-primary" />
    </div>
</form>

<div class="back_btn">
    <a  asp-action="Index">Powrót do listy</a>
</div>

