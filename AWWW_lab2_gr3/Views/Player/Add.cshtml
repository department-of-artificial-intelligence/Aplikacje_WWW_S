@model AWWW_lab2_gr3.Models.Player;

<h1>Dodaj Drużynę</h1>

<form asp-action="Add" method="POST" class="w3-container">
    <p>
        <label asp-for="FirstName">Imię :</label>
        <input asp-for="FirstName" class="w3-input w3-border"/>
    </p>
    <p>
        <label asp-for="LastName">Nazwisko :</label>
        <input asp-for="LastName" class="w3-input w3-border"/>
    </p>
    <p>
        <label asp-for="Country">Panstwo :</label>
        <input asp-for="Country" class="w3-input w3-border"/>
    </p>
    <p>
        <label asp-for="BirthDate">Data urodzenia :</label>
        <input asp-for="BirthDate" class="w3-input w3-border"/>
    </p>
    <p>
        <label asp-for="TeamId">Drużyny :</label>
        @foreach(var t in @ViewBag.Teams)
        {
            <label>@t.Text</label>
            <input type="radio" name="TeamId" value="@t.Value" class="w3-check">
        }
    </p>
    <p>
        <label asp-for="Positions">Pozycje :</label>
        @foreach(var p in @ViewBag.Positions)
        {
            <label>@p.Text</label>
            <input type="checkbox" name="Positions" value="@p.Value" class="w3-check">
        }
    </p>

    <p>
        <button type="submit" class="w3-btn w3-border">Dodaj</button>
    </p>
</form>


