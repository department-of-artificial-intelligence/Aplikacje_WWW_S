@model AWWW_lab2_gr3.Models.Player

<h1>Edytuj Gracza</h1>

<form asp-action="Edit" method="post" class="w3-container">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="FirstName">Imię </label>
        <input asp-for="FirstName" class="w3-input w3-border" />
    </div>

    <div class="form-group">
        <label asp-for="LastName">Nazwisko </label>
        <input asp-for="LastName" class="w3-input w3-border" />
    </div>

    <div class="form-group">
        <label asp-for="Country">Kraj </label>
        <input asp-for="Country" class="w3-input w3-border" />
    </div>

    <div class="form-group">
        <label asp-for="BirthDate">Data urodzenia: </label>
        <input asp-for="BirthDate" class="w3-input w3-border" type="date" />
    </div>

    <div class="form-group">
        <label asp-for="TeamId">Drużyna: </label>
        <select asp-for="TeamId" asp-items="ViewBag.TeamList" class="w3-input w3-border"></select>
    </div>

    <div class="form-group">
        <label asp-for="Positions">Pozycja </label>
        @foreach (var pos in @ViewBag.PositionList)
        {
            bool isChecked = pos.Selected;
            <p>
                <input type="checkbox" name="Positions" value="@pos.Value" class="w3-check" @(isChecked ? "checked" : "") />
                <label>@pos.Text</label>
            </p>

        }
    </div>

    <div class="form-group">
        <input type="submit" value="Zapisz" class="btn btn-primary" />
    </div>
</form>

<div class="back_btn">
    <a asp-action="Index">Powrót do listy</a>
</div>
