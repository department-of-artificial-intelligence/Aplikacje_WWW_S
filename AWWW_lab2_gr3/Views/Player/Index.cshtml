@model ICollection<AWWW_lab2_gr3.Models.Player>

<h1>Witamy w zakładce graczy!</h1>
<p>
    Gracze będą tutaj.
    <a asp-action="Add" asp-controller="Player" class="w3-btn ">Dodaj</a><br>
    <table>
    @if(Model != null){
    @foreach (var player in Model)
            {
                <tr>
                    <td>@player.FirstName</td>
                    <td>@player.LastName</td>
                    <td>@player.Country</td>
                    <td><a asp-action="Edit" asp-controller="Player" class="w3-btn" asp-route-id="@player.Id">Edytuj</a><span> | </span><a asp-action="Delete" asp-controller="Player" class="w3-btn" asp-route-id="@player.Id">Usuń</a></td>
                </tr>
            }}
    </table>
</p>