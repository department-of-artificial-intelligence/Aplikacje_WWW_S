@model List<AWWW_lab2_gr3.Models.Player>

<h1>Lista Graczy</h1>

<table class="table">
    <thead>
        <tr>
            <th>Imie</th>
            <th>Nazwisko</th>
            <th>Kraj</th>
            <th>Data urodzenia</th>
            <th>Druznyna</th>
            <th>Pozycja</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var player in Model)
        {
            <tr>
                <td>@player.FirstName</td>
                <td>@player.LastName</td>
                <td>@player.Country</td>
                <td>@player.Country</td>
                <td>@player.Team.Name</td>
                <td>
                    <ul>
                        @foreach (var position in player.Positions)
                        {
                            <li>@position.Name</li>
                        }
                    </ul>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@player.Id">Edytuj</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p>
    <a asp-action="Add" class="btn">Dodaj</a>
</p>