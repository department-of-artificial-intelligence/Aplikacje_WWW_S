@model AS_l2.Models.Position

<h1>Dodaj Pozycję</h1>

<form asp-route="Add" method="post" class="w3-container">
    <p>
        <label asp-for="Name">Nazwa pozycji :</label>
        <input asp-for="Name" class="w3-input w3-border"/>
    </p>
    <p>
        <label asp-for="Player">Gracz :</label>
        <select asp-for="PlayerId" asp-items="@ViewBag.playerList" class="w3-input w3-border"></select>
    </p>
    <p>
        <button type="submit" class="w3-btn w3-border">Dodaj</button>
    </p>
</form>


