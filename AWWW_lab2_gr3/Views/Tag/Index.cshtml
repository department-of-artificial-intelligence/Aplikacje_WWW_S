@model List<AWWW_lab2_gr3.Models.Tag>


<h1>Lista Pozycji</h1>

<table class="table">
    <thead>
        <tr>
            <th>Nazwa</th>
      
        </tr>
    </thead>
    <tbody>
        @foreach (var tag in Model)
        {
            <tr>
                
                <td>@tag.Name</td>
            </tr>
        }
    </tbody>
</table>

<p>
    <a asp-action="Add" class="btn">Dodaj</a>
</p>