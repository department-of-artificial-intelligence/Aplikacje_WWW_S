@model ICollection<AWWW_lab2_gr3.Models.Tag>

<h1>@ViewBag.Title</h1>

<h1>Witamy w zakładce Tagi!</h1>
<p>
    Tu będą Tagi!<a asp-action="Add" asp-controller="Tag" class="w3-btn">Dodaj</a><br>
    <table>
    @if(Model != null)
    {
        @foreach(var t in Model)
        {
            <tr>
                <td>@t.Name</td>
            </tr>
        }
    }
    </table>
</p>