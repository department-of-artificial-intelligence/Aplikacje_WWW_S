@model List<AWWW_lab2_gr3.Models.Team>

<h1>Lista Druzyn</h1>

<table class="table">
    <thead>
        <tr>
            <th>Nazwa</th>
            <th>Kraj</th>
            <th>Miasto</th>
            <th>Data zalozenia</th>
            <th>Liga</th>
            <th>Akcja</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var team in Model)
        {
            <tr>
                <td>@team.Name</td>
                <td>@team.Country</td>
                <td>@team.City</td>
                <td>@team.FoundingDate</td>
                <td>@(team.League != null ? team.League.Name : "Brak ligi")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@team.Id">Edytuj</a>
                    <br />
                    <a asp-action="Delete" asp-route-id="@team.Id">Usun</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p>
    <a asp-action="Add" class="btn">Dodaj</a>
</p>