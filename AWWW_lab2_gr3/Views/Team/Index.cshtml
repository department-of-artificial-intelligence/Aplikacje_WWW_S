@model ICollection<AWWW_lab2_gr3.Models.Team>

<h1>Witamy w zakładce Drużyn!</h1>
<p>
    Drużyny będą tutaj.
    <a asp-action="Add" asp-controller="Team" class="w3-btn ">Dodaj</a><br>
    <table>
    @if(Model != null){
    @foreach (var team in Model)
            {
                <tr>
                    <td>@team.Name</td>
                    <td>@team.Country</td>
                    <td>@team.City</td>         
                    <td><a asp-action="Edit" asp-controller="Team" class="w3-btn" asp-route-id="@team.Id">Edytuj</a><span> | </span><a asp-action="Delete" asp-controller="Team" class="w3-btn" asp-route-id="@team.Id">Usuń</a></td>   
                </tr>
                @foreach(var p in team.Players)
                {
                    <tr>
                        <td></td><td>@p.FirstName</td><td>@p.LastName</td>
                    </tr>
                    @foreach(var po in p.Positions)
                    {
                        <tr>
                            <td></td><td></td><td>@po.Name</td>
                        </tr>
                    }
                }
            }}
    </table>
</p>