@model AWWW_lab3_gr1.Models.Address

@{
    ViewData["Title"] = "Dodaj adres";
}

<h1 class="mb-4">Dodaj adres</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="CustomerId" class="form-label">Id klienta</label>
                <input asp-for="CustomerId" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Miasto</label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Street" class="form-label">Ulica</label>
                <input asp-for="Street" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="PostalCode" class="form-label">Kod pocztowy</label>
                <input asp-for="PostalCode" class="form-control" />
            </div>

            <button type="submit" class="btn btn-success">Zapisz</button>
            <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
        </form>
    </div>
</div>