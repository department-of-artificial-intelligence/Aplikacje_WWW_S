@model IEnumerable<AWWW_lab3_gr1.Models.Address>

@{
    ViewData["Title"] = "Adresy";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Adresy</h1>
    <a asp-action="Create" class="btn btn-success">Dodaj adres</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>CustomerId</th>
            <th>Miasto</th>
            <th>Ulica</th>
            <th>Kod pocztowy</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.CustomerId</td>
                <td>@item.Name</td>
                <td>@item.Street</td>
                <td>@item.PostalCode</td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Powrót</a>