@model Web.ViewModels.RoomEquipment.EditRoomEquipmentViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="w3-panel w3-card-4 w3-padding" style="max-width: 600px; margin-top: 20px;">
    <h2>Edycja ilości wyposażenia</h2>
    <hr />

    <p><strong>Sala:</strong> @Model.RoomName</p>
    <p><strong>Wyposażenie:</strong> @Model.EquipmentName</p>

    <form asp-action="Edit" method="post" class="w3-container w3-margin-top">
        <input asp-for="RoomId" type="hidden" />
        <input asp-for="EquipmentId" type="hidden" />
        <input asp-for="RoomName" type="hidden" />
        <input asp-for="EquipmentName" type="hidden" />

        <div class="w3-section">
            <label asp-for="Quantity" class="w3-text-dark-grey"><strong>Zmień ilość sztuk:</strong></label>
            <input asp-for="Quantity" class="w3-input w3-border w3-round" type="number" min="1" style="max-width: 150px;" />
            <span asp-validation-for="Quantity" class="w3-text-red"></span>
        </div>

        <div asp-validation-summary="ModelOnly" class="w3-text-red w3-margin-bottom"></div>

        <div class="w3-padding-16">
            <button type="submit" class="w3-button w3-green w3-round">Zapisz zmiany</button>
            <a class="w3-button w3-light-grey w3-round" asp-controller="Room" asp-action="Details" asp-route-id="@Model.RoomId">Anuluj</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}