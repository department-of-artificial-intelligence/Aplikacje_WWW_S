@model Web.ViewModels.Building.CreateBuildingViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dodaj budynek";
}

<div class="w3-panel w3-card-4 w3-padding">
    <h2>Dodaj budynek</h2>

    <form asp-action="Create" method="post" class="w3-container">
        <div class="w3-section">
            <label asp-for="Name"></label>
            <input class="w3-input" asp-for="Name" />
            <span asp-validation-for="Name" class="w3-text-red"></span>
        </div>

        <div class="w3-section">
            <label asp-for="Address"></label>
            <input class="w3-input" asp-for="Address" />
            <span asp-validation-for="Address" class="w3-text-red"></span>
        </div>

        <div class="w3-section">
            <label asp-for="Description"></label>
            <textarea class="w3-input" asp-for="Description" rows="3"></textarea>
            <span asp-validation-for="Description" class="w3-text-red"></span>
        </div>

        <div class="w3-section">
            <button class="w3-button w3-blue" type="submit">Zapisz</button>
            <a class="w3-button w3-light-grey" asp-action="Index">Anuluj</a>
        </div>
    </form>
</div>