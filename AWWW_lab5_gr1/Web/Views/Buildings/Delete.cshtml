@model Services.DTO.Building.BuildingDto

<h1>Usuń budynek</h1>

<h3>Czy na pewno chcesz usunąć ten budynek?</h3>

<div class="mb-3">
    <strong>Nazwa:</strong> @Model.Name
</div>

<div class="mb-3">
    <strong>Adres:</strong> @Model.Address
</div>

<div class="mb-3">
    <strong>Opis:</strong> @Model.Description
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Usuń</button>
    <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
</form>