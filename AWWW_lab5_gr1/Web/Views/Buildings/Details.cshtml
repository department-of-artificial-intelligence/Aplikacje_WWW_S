@model Web.ViewModels.Building.DetailsBuildingViewModel

@{
    ViewData["Title"] = "Szczegóły budynku";
}

<div class="card shadow-sm my-4">
    <div class="card-body">
        <h3 class="card-title mb-4">Szczegóły budynku</h3>

        <div class="mb-4">
            <p><strong>Nazwa:</strong> @Model.Name</p>
            <p><strong>Adres:</strong> @Model.Address</p>
            <p><strong>Opis:</strong> @Model.Description</p>
        </div>

        <div class="mb-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success me-2">Edytuj budynek</a>
            <a asp-action="Index" class="btn btn-light border">Powrót do listy budynków</a>
        </div>

        <h4 class="mt-5 mb-3">Sale w budynku</h4>
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nazwa</th>
                    <th>Pojemność</th>
                    <th>Piętro</th>
                    <th>Aktywna</th>
                    <th style="width: 150px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rooms != null && Model.Rooms.Any())
                {
                    @foreach (var room in Model.Rooms)
                    {
                        <tr>
                            <td>@room.Name</td>
                            <td>@room.Capacity</td>
                            <td>@room.Floor</td>
                            <td>@(room.IsActive ? "Tak" : "Nie")</td>
                            <td class="text-center">
                                <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id" class="btn btn-sm text-white" style="background-color: #3b5998;">Szczegóły sali</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">Brak zarejestrowanych sal w tym budynku.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>