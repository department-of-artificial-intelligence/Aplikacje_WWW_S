@model Web.ViewModels.Equipment.DeleteEquipmentViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Usuń wyposażenie";
}

<div class="w3-panel w3-card-4 w3-padding">
    <h2 class="w3-text-red">Usuń wyposażenie</h2>
    <h3>Czy na pewno chcesz usunąć to wyposażenie?</h3>

    <div class="w3-container w3-margin-bottom">
        <p><strong>Nazwa:</strong> @Model.Name</p>
        <p><strong>Opis:</strong> @Model.Description</p>
        <p><strong>Mobilne:</strong> @(Model.IsMobile ? "Tak" : "Nie")</p>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="w3-button w3-red">Usuń</button>
        <a asp-action="Index" class="w3-button w3-light-grey">Anuluj</a>
    </form>
</div>