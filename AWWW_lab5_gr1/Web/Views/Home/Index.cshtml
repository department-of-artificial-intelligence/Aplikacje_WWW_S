@{
    ViewData["Title"] = "Panel Główny";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-dark">System Zarządzania Rezerwacjami</h1>
            <p class="col-md-8 fs-4 text-muted">
                Witaj w panelu administracyjnym. Wybierz jeden z poniższych modułów, aby zarządzać zasobami i konfiguracją aplikacji.
            </p>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border">
                <div class="card-body d-flex flex-column text-center">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-building fs-1"></i>
                    </div>
                    <h5 class="card-title fw-bold">Budynki</h5>
                    <p class="card-text text-muted small flex-grow-1">Przeglądaj, dodawaj, edytuj i usuwaj budynki w systemie oraz przypisane do nich sale.</p>
                    <a asp-controller="Buildings" asp-action="Index" class="btn btn-primary w-100 mt-3">Zarządzaj budynkami</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border">
                <div class="card-body d-flex flex-column text-center">
                    <div class="mb-3 text-success">
                        <i class="bi bi-door-closed fs-1"></i>
                    </div>
                    <h5 class="card-title fw-bold">Sale dydaktyczne</h5>
                    <p class="card-text text-muted small flex-grow-1">Zarządzaj salami, konfiguruj ich pojemność, lokalizację na piętrach oraz status aktywności.</p>
                    <a asp-controller="Rooms" asp-action="Index" class="btn btn-success w-100 mt-3">Zarządzaj salami</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border">
                <div class="card-body d-flex flex-column text-center">
                    <div class="mb-3 text-warning">
                        <i class="bi bi-calendar-event fs-1"></i>
                    </div>
                    <h5 class="card-title fw-bold">Typy wydarzeń</h5>
                    <p class="card-text text-muted small flex-grow-1">Konfiguruj kategorie i typy wydarzeń (np. wykłady, laboratoria) oraz sprawdzaj powiązane grafiki.</p>
                    <a asp-controller="EventTypes" asp-action="Index" class="btn btn-warning text-white w-100 mt-3">Zarządzaj typami</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border">
                <div class="card-body d-flex flex-column text-center">
                    <div class="mb-3 text-danger">
                        <i class="bi bi-pc-display fs-1"></i>
                    </div>
                    <h5 class="card-title fw-bold">Wyposażenie</h5>
                    <p class="card-text text-muted small flex-grow-1">Zarządzaj bazą dostępnego sprzętu i multimediów (np. projektory, komputery) przypisanych do sal.</p>
                    <a asp-controller="Equipment" asp-action="Index" class="btn btn-danger w-100 mt-3">Zarządzaj sprzętem</a>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-5 p-4 border rounded shadow-sm bg-white">
        <h5 class="fw-bold mb-3"><i class="bi bi-info-circle text-info me-2"></i>Wskazówka dla administratora</h5>
        <p class="text-muted mb-0 small">
            Wszystkie operacje modyfikacji danych (dodawanie, edycja, usuwanie) są zabezpieczone tokenami anty-fałszerskimi (Antiforgery) oraz podlegają automatycznemu mapowaniu obiektów DTO za pomocą biblioteki AutoMapper. W przypadku problemów z powiązaniami obiektów, sprawdź komunikaty błędów walidacji biznesowej bezpośrednio na formularzach akcji.
        </p>
    </div>
</div>