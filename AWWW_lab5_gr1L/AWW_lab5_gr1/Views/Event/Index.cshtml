@model IEnumerable<Web.ViewModels.Event.IndexEventViewModel>

<div class="w3-container w3-margin-top">
    <div class="w3-row">
        <div class="w3-col m9">
            <h2>Lista Wydarzeń</h2>
        </div>
        <div class="w3-col m3 w3-right-align">
            <a asp-action="Create" class="w3-button w3-green w3-round w3-margin-top">Dodaj nowe wydarzenie</a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="w3-table-all w3-card-4 w3-margin-top">
            <thead>
                <tr class="w3-light-grey">
                    <th>Tytuł wydarzenia</th>
                    <th>Typ</th>
                    <th>Widoczność</th>
                    <th style="width: 250px;">Opcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.EventTypeName</td>
                        <td>
                            @if (item.IsPublic)
                            {
                                <span class="w3-tag w3-blue w3-round">Publiczne</span>
                            }
                            else
                            {
                                <span class="w3-tag w3-gray w3-round">Prywatne</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="w3-button w3-small w3-blue w3-round">Szczegóły / Rezerwacje</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="w3-button w3-small w3-yellow w3-round">Edytuj</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="w3-panel w3-light-grey w3-padding-large w3-center w3-round">Brak zaplanowanych wydarzeń.</p>
    }
</div>