@model Web.ViewModels.Reservation.CreateReservationViewModel

<div class="w3-card-4 w3-padding w3-white w3-margin-top" style="max-width:600px;">
    <h2>Rezerwacja sali dla: <span class="w3-text-blue">@Model.EventName</span></h2>
    <hr />

    <form asp-action="Create" method="post" class="w3-container">
        <input type="hidden" asp-for="EventId" />
        <input type="hidden" asp-for="EventName" />

        <div class="w3-section">
            <label asp-for="RoomId"><strong>Wybierz salę lekcyjną:</strong></label>
            <select asp-for="RoomId" asp-items="Model.Rooms" class="w3-select w3-border w3-round">
                <option value="">-- Wybierz dostępną salę --</option>
            </select>
            <span asp-validation-for="RoomId" class="w3-text-red"></span>
        </div>

        <div class="w3-section">
            <label asp-for="StartTime"><strong>Czas rozpoczęcia:</strong></label>
            <input asp-for="StartTime" class="w3-input w3-border w3-round" type="datetime-local" />
            <span asp-validation-for="StartTime" class="w3-text-red"></span>
        </div>

        <div class="w3-section">
            <label asp-for="EndTime"><strong>Czas zakończenia:</strong></label>
            <input asp-for="EndTime" class="w3-input w3-border w3-round" type="datetime-local" />
            <span asp-validation-for="EndTime" class="w3-text-red"></span>
        </div>

        <div asp-validation-summary="ModelOnly" class="w3-text-red w3-margin-bottom"></div>

        <div class="w3-padding-16">
            <button type="submit" class="w3-button w3-green w3-round">Zgłoś rezerwację</button>
            <a asp-controller="Event" asp-action="Details" asp-route-id="@Model.EventId" class="w3-button w3-light-grey w3-round">Anuluj</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}