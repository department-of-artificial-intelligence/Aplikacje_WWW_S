@model Web.ViewModels.Room.EditRoomViewModel

<div class="w3-card-4 w3-padding" style="max-width:700px;">
    <h3>Edytuj salę: @Model.Name</h3>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="w3-section">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="w3-input w3-border" />
            <span asp-validation-for="Name" class="w3-text-red"></span>
        </div>

        <div class="w3-section">
            <label asp-for="BuildingId"></label>
            <select asp-for="BuildingId" asp-items="Model.Buildings" class="w3-select w3-border"></select>
            <span asp-validation-for="BuildingId" class="w3-text-red"></span>
        </div>

        <div class="w3-row-padding">
            <div class="w3-half">
                <label asp-for="Capacity"></label>
                <input asp-for="Capacity" class="w3-input w3-border" type="number" />
            </div>
            <div class="w3-half">
                <label asp-for="Floor"></label>
                <input asp-for="Floor" class="w3-input w3-border" type="number" />
            </div>
        </div>

        <div class="w3-section w3-padding">
            <input asp-for="IsActive" class="w3-check" type="checkbox" />
            <label asp-for="IsActive"></label>
        </div>

        <div class="w3-section">
            <button type="submit" class="w3-button w3-blue">Zapisz zmiany</button>
            <a asp-action="Index" class="w3-button w3-light-grey">Anuluj</a>
        </div>
    </form>
</div>