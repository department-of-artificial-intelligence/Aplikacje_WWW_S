@model IEnumerable<Web.ViewModels.Room.IndexRoomViewModel>

<h2>Lista sal konferencyjnych i lekcyjnych</h2>

<p>
    <a asp-action="Create" class="w3-button w3-blue w3-round">Dodaj nową salę</a>
</p>

<table class="w3-table-all w3-card-4">
    <thead>
        <tr class="w3-light-grey">
            <th>Nazwa sali</th>
            <th>Budynek</th>
            <th>Pojemność</th>
            <th>Piętro</th>
            <th>Status</th>
            <th style="width:250px;">Opcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td><span class="w3-tag w3-light-blue w3-round">@item.BuildingName</span></td>
                <td>@item.Capacity os.</td>
                <td>@item.Floor</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="w3-text-green"><i class="fa fa-check"></i> Aktywna</span>
                    }
                    else
                    {
                        <span class="w3-text-red"><i class="fa fa-times"></i> Nieaktywna</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="w3-button w3-indigo w3-small">Szczegóły</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="w3-button w3-green w3-small">Edytuj</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="w3-button w3-red w3-small">Usuń</a>
                </td>
            </tr>
        }
    </tbody>
</table>