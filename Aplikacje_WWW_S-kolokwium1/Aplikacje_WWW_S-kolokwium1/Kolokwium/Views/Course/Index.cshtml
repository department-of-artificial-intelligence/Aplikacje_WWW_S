@model List<Kolokwium.Models.Course>

<h2>Kursy</h2>

<a asp-action="Create">Dodaj kurs</a>

<table border="1">
    <tr>
        <th>Tytuł</th>
        <th>Instruktor</th>
        <th>Studenci</th>
        <th>Akcje</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Instructor?.Name</td>
            <td>
                @foreach (var s in item.Students)
                {
                    @s.Name <br />
                }
            </td>
            <td>
                <a asp-action="AddStudent" asp-route-id="@item.Id">Dodaj studenta</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Usuń</a>
            </td>
        </tr>
    }
</table>