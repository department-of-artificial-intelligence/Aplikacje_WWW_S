@model IEnumerable<Kolokwium.Models.Meal>

<a href="/Meal/Index.cshtml">Lista posilkow</a>

<table border="1">
    <tr>
        <th>Id</th>
        <th>Typ</th>
        <th>CzyWege</th>
        <th>Opis</th>
        <th>Cena</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Type</td>
            <td>@item.IsVegetarian</td>
            <td>@item.Description</td>
            <td>@item.Price</td>
        </tr>
    }
</table>