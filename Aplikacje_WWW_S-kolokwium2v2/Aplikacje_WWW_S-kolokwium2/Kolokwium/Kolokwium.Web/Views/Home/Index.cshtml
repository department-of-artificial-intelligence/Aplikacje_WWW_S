@{
    ViewData["Title"] = "Strona Główna - Panel Kolokwium";
}

<div class="text-center my-5">
    <h1 class="display-4 fw-bold text-primary">System Zarządzania Seansem Kinowym</h1>
    <p class="lead text-muted">Wybierz jedną z poniższych opcji, aby przejść do zarządzania repertuarem.</p>
    <hr class="my-4" style="max-width: 600px; margin: 0 auto;" />
</div>

<div class="container">
    <div class="row justify-content-center g-4">

        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-2 border-primary-subtle">
                <div class="card-body d-flex flex-column text-center">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-film" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="card-title h4 fw-semibold">Lista Seansów</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Przeglądaj wszystkie zaplanowane seanse filmowe przypisane do konkretnych kin wraz z listą aktorów.
                    </p>
                    <a asp-controller="Screening" asp-action="Index" class="btn btn-primary btn-lg mt-3 fw-medium shadow-sm">
                        Otwórz Listę Seansów
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-2 border-success-subtle">
                <div class="card-body d-flex flex-column text-center">
                    <div class="mb-3 text-success">
                        <i class="bi bi-plus-circle-dark" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="card-title h4 fw-semibold">Dodaj Nowy Seans</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Uruchom formularz tworzenia nowego seansu, zdefiniuj tytuł filmu, czas rozpoczęcia oraz powiąż go z kinem.
                    </p>
                    <a asp-controller="Screening" asp-action="Create" class="btn btn-success btn-lg mt-3 fw-medium shadow-sm">
                        Utwórz Nowy Seans
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>