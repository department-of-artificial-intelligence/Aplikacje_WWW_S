@model Kolokwium.Web.ViewModels.Person.DetailsPersonViewModel

<h1>Szczegóły Osoby</h1>

<p><strong>ID:</strong> @Model.Id</p>
<p><strong>Imię i Nazwisko:</strong> @Model.FullName</p>
<p><strong>Data rejestracji:</strong> @Model.RegistrationDate.ToString("yyyy-MM-dd")</p>
<p><strong>Wiek:</strong> @Model.Age</p>

<a href="/Person/Edit/@Model.Id"><button type="button">Edytuj</button></a>
<a href="/Person/Index"><button type="button">Powrót</button></a>