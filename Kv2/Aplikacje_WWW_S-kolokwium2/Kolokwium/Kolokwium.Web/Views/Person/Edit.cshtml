@model Kolokwium.Web.ViewModels.Person.EditPersonViewModel

<h1>Edytuj Osobę</h1>

<form action="/Person/Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="Id" value="@Model.Id" />

    <label>Imię:</label><br />
    <input type="text" name="FirstName" value="@Model.FirstName" required /><br /><br />

    <label>Nazwisko:</label><br />
    <input type="text" name="LastName" value="@Model.LastName" required /><br /><br />

    <label>Data rejestracji:</label><br />
    <input type="date" name="RegistrationDate" value="@Model.RegistrationDate.ToString("yyyy-MM-dd")" required /><br /><br />

    <label>Wiek:</label><br />
    <input type="number" name="Age" value="@Model.Age" required /><br /><br />

    <button type="submit">Zapisz zmiany</button>
    <a href="/Person/Index"><button type="button">Anuluj</button></a>
</form>