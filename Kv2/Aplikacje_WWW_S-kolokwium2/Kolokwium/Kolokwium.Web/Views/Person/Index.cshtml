@model IEnumerable<Kolokwium.Web.ViewModels.Person.PersonViewModel>

<h1>Lista Osób</h1>

<a href="/Person/Create">
    <button type="button">Dodaj nową osobę</button>
</a>

<br />
<br />

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>Pełne Imię i Nazwisko</th>
            <th>Data rejestracji</th>
            <th>Wiek</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.RegistrationDate.ToString("yyyy-MM-dd")</td>
                <td>@item.Age</td>
                <td>
                    <a href="/Person/Details/@item.Id"><button type="button">Szczegóły</button></a>
                    <a href="/Person/Edit/@item.Id"><button type="button">Edytuj</button></a>

                    <form action="/Person/Delete/@item.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" onclick="return confirm('Na pewno usunąć?')">Usuń</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>