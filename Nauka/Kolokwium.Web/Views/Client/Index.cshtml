@model IEnumerable<Kolokwium.ViewModel.VM.Client.ClientVm>
    <div class="w3-container w3-padding">
        <h2>Lista klientow</h2>

        <a asp-action="Create" class="w3-button w3-blue w3-margin-bottom">Dodaj nowego klienta</a>

        <table class="w3-table-all w3-hoverable">
            <thead>
                <tr class="w3-light-grey">
                    <th>ID</th>
                    <th>Data rejestracji</th>
                    <th>Imię</th>
                    <th>Nazwisko</th>
                    <th>Email</th>
                    <th>Telefon</th>
                    <th>Zamówienia</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model){
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.RegistrationDate</td>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>
                            @if (item.Orders != null && item.Orders.Any()){
                                @string.Join(", ", item.Orders)
                            }
                            else{
                                <span class="w3-text-gray">Brak</span>
                            }
                        </td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Czy na pewno usunąć?');">
                            <button type="submit" class="w3-button w3-red w3-tiny">Usuń</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>