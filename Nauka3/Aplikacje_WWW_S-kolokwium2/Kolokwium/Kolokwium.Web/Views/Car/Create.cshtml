@model Kolokwium.Web.ViewModels.Car.CreateCarViewModel

@{
    ViewData["Title"] = "Nowy Samochód";
}

<div style="max-width: 500px;">
    <div>
        <div class="w3-container w3-blue">
            <h2>Dodaj Samochód</h2>
        </div>
        <form asp-controller="Car" asp-action="Create" method="post" class="w3-container w3-padding">
            @Html.AntiForgeryToken()

            <p>
                <label asp-for="Brand"><b>Marka</b></label>
                <input asp-for="Brand" class="w3-input w3-border w3-round" type="text" />
                <span asp-validation-for="Brand" class="w3-text-red w3-small"></span>
            </p>

            <p>
                <label asp-for="Model" class="w3-text-blue"><b>Model</b></label>
                <input asp-for="Model" class="w3-input w3-border w3-round" type="text" />
                <span asp-validation-for="Model" class="w3-text-red w3-small"></span>
            </p>

            <p>
                <label asp-for="DriverId" class="w3-text-blue"><b>Kierowca</b></label>
                <select asp-for="DriverId" asp-items="Model.Drivers" class="w3-select w3-border w3-round">
                    <option value="">-- Wybierz kierowcę --</option>
                </select>
                <span asp-validation-for="DriverId" class="w3-text-red w3-small"></span>
            </p>

            <div class="w3-margin-top w3-padding-16">
                <button type="submit" class="w3-button w3-green w3-round"><i class="fa fa-save"></i> Zapisz</button>
                <a asp-action="Index" class="w3-button w3-grey w3-round">Anuluj</a>
            </div>
        </form>
        <div asp-validation-summary="All" class="w3-text-red w3-margin-bottom"></div>
    </div>
</div>