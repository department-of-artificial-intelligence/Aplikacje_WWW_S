@model Kolokwium.Web.ViewModels.Car.DetailsCarViewModel

@{
    ViewData["Title"] = "Szczegóły Samochodu";
}

<div class="w3-container w3-margin-top" style="max-width: 600px;">
    <div class="w3-card-4">
        <div class="w3-container w3-teal">
            <h2>Szczegóły pojazdu: @Model.Brand @Model.Model</h2>
        </div>

        <div class="w3-container w3-padding">
            <h4><b>Kierowca przypisany do auta:</b></h4>
            <p class="w3-large w3-padding-left"><i class="fa fa-user"></i> @Model.DriverFirstName @Model.DriverLastName</p>

            <hr />

            @if (string.IsNullOrEmpty(Model.DocumentNumber))
            {
                <div class="w3-panel w3-pale-amber w3-leftbar w3-border-amber w3-padding">
                    <p>Ten samochód nie posiada jeszcze przypisanego dowodu rejestracyjnego.</p>
                    <a asp-controller="Registration" asp-action="Create" asp-route-carId="@Context.Request.RouteValues["id"]" class="w3-button w3-blue w3-round w3-small">
                        <i class="fa fa-file-text"></i> Wyrób dowód rejestracyjny
                    </a>
                </div>
            }
            else
            {
                <ul class="w3-ul w3-border w3-round">
                    <li><b>Numer dokumentu:</b> @Model.DocumentNumber</li>
                    <li><b>Data wydania:</b> @Model.RegistrationIssueDate?.ToString("dd.MM.yyyy")</li>
                </ul>
            }
        </div>

        <div class="w3-container w3-light-grey w3-padding">
            <a asp-action="Index" class="w3-button w3-grey w3-round">Powrót do listy</a>
        </div>
    </div>
</div>