@model Kolokwium.Web.ViewModels.Car.EditCarViewModel

@{
    ViewData["Title"] = "Edycja Samochodu";
}

<div class="w3-container w3-margin-top" style="max-width: 500px;">
    <div class="w3-card-4">
        <div class="w3-container w3-amber">
            <h2>Edytuj Samochód</h2>
        </div>
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <p>
                <label asp-for="Brand"><b>Marka</b></label>
                <input asp-for="Brand" type="text" />
                <span asp-validation-for="Brand"></span>
            </p>

            <p>
                <label asp-for="Model" class="w3-text-brown"><b>Model</b></label>
                <input asp-for="Model" class="w3-input w3-border w3-round" type="text" />
                <span asp-validation-for="Model" class="w3-text-red w3-small"></span>
            </p>
            <p>
                <label asp-for="DriverId" class="w3-text-brown"><b>Kierowca</b></label>
                <select asp-for="DriverId" asp-items="Model.Drivers" class="w3-select w3-border w3-round">
                    <option value="">-- Wybierz kierowcę --</option>
                </select>
                <span asp-validation-for="DriverId" class="w3-text-red w3-small"></span>
            </p>

            <div class="w3-margin-top w3-padding-16 w3-bar">
                <button type="submit" class="w3-button w3-green w3-round w3-bar-item"><i class="fa fa-save"></i> Zapisz zmiany</button>
                <a asp-action="Index" class="w3-button w3-grey w3-round w3-bar-item w3-margin-left">Anuluj</a>

                <a asp-action="Delete" asp-route-id="@Model.Id" class="w3-button w3-red w3-round w3-bar-item w3-right"><i class="fa fa-trash"></i> Usuń auto</a>
            </div>
        </form>
    </div>
</div>