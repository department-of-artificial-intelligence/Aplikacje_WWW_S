@model Kolokwium.Web.ViewModels.Driver.DetailsDriverViewModel

@{
    ViewData["Title"] = "Szczegóły Kierowcy";
}

<div class="w3-container w3-margin-top" style="max-width: 700px;">
    <div class="w3-card-4">
        <div class="w3-container w3-teal">
            <h2>Profil Kierowcy</h2>
        </div>

        <div class="w3-container w3-padding">
            <h3><b>@Model.FirstName @Model.LastName</b></h3>
            <hr />

            <h4><b>Przypisane samochody (Relacja 1:N):</b></h4>
            @if (!Model.Cars.Any())
            {
                <p class="w3-text-grey w3-padding-left">Ten kierowca nie posiada jeszcze żadnych przypisanych pojazdów.</p>
            }
            else
            {
                <table class="w3-table w3-striped w3-bordered w3-border">
                    <thead>
                        <tr class="w3-light-grey">
                            <th>Marka</th>
                            <th>Model</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var car in Model.Cars)
                        {
                            <tr>
                                <td>@car.Brand</td>
                                <td>@car.Model</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="w3-container w3-light-grey w3-padding">
            <a asp-action="Index" class="w3-button w3-grey w3-round">Powrót do listy</a>
        </div>
    </div>
</div>