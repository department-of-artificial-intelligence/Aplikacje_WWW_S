@model Kolokwium.Web.ViewModels.Registration.CreateRegistrationViewModel

@{
    ViewData["Title"] = "Nowy Dowód Rejestracyjny";
}

<div class="w3-container w3-margin-top" style="max-width: 500px;">
    <div class="w3-card-4">
        <div class="w3-container w3-blue">
            <h2>Wyrób Dowód Rejestracyjny</h2>
        </div>

        <form asp-action="Create" method="post" class="w3-container w3-padding">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="CarId" />

            <div class="w3-panel w3-light-grey w3-padding w3-border w3-round">
                <p class="w3-small w3-text-grey">
                    <i class="fa fa-info-circle"></i> Dokument zostanie automatycznie powiązany z samochodem, z poziomu którego kliknąłeś „Wyrób dowód”.
                </p>
            </div>

            <p>
                <label asp-for="DocumentNumber" class="w3-text-blue"><b>Numer dokumentu</b></label>
                <input asp-for="DocumentNumber" class="w3-input w3-border w3-round" type="text" placeholder="np. ABC 12345" />
                <span asp-validation-for="DocumentNumber" class="w3-text-red w3-small"></span>
            </p>

            <p>
                <label asp-for="IssueDate" class="w3-text-blue"><b>Data wydania</b></label>
                <input asp-for="IssueDate" class="w3-input w3-border w3-round" type="date" />
                <span asp-validation-for="IssueDate" class="w3-text-red w3-small"></span>
            </p>

            <div class="w3-margin-top w3-padding-16">
                <button type="submit" class="w3-button w3-green w3-round">
                    <i class="fa fa-save"></i> Zatwierdź i zapisz
                </button>
                <a asp-controller="Car" asp-action="Details" asp-route-id="@Model.CarId" class="w3-button w3-grey w3-round">
                    Anuluj
                </a>
            </div>
        </form>
    </div>
</div>