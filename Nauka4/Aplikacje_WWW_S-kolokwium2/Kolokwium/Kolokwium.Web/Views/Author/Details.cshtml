@model Kolokwium.Web.ViewModels.Author.DetailsAuthorViewModel

@{
    ViewData["Title"] = "Szczegóły Autora";
}

<div class="w3-container w3-margin-top" style="max-width: 700px;">
    <div class="w3-card-4">
        <div class="w3-container w3-teal">
            <h2>Profil Autora</h2>
        </div>

        <div class="w3-container w3-padding">
            <h3><b>@Model.FullName</b></h3>
            <hr />

            @if (!Model.Books.Any())
            {
                <p class="w3-text-grey w3-padding-left">Ten autor nie posiada jeszcze żadnych przypisanych ksiazek.</p>
            }
            else
            {
                <table class="w3-table w3-striped w3-bordered w3-border">
                    <thead>
                        <tr class="w3-light-grey">
                            <th>Tytul</th>
                            <th>Wydawca</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.Books)
                        {
                            <tr>
                                <td>@book.Title</td>
                                <td>@book.PublisherName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="w3-container w3-light-grey w3-padding">
            <a asp-action="Index" class="w3-button w3-grey w3-round">Powrót do listy</a>
        </div>
    </div>
</div>