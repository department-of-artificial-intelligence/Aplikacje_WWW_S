@model Kolokwium.Web.ViewModels.Author.EditAuthorViewModel

@{
    ViewData["Title"] = "Edycja Autora";
}

<div class="w3-container w3-margin-top" style="max-width: 500px;">
    <div class="w3-card-4">
        <div class="w3-container w3-blue">
            <h2>Edytuj Autora</h2>
        </div>
        <form asp-action="Edit" method="post" class="w3-container w3-padding">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <p>
                <label asp-for="FullName" class="w3-text-blue"><b>Imię i nazwisko</b></label>
                <input asp-for="FullName" class="w3-input w3-border w3-round" type="text" />
                <span asp-validation-for="FullName" class="w3-text-red w3-small"></span>
            </p>

            <div class="w3-margin-top w3-padding-16">
                <button type="submit" class="w3-button w3-green w3-round"><i class="fa fa-save"></i> Zapisz</button>
                <a asp-action="Index" class="w3-button w3-grey w3-round">Anuluj</a>
            </div>
        </form>
    </div>
</div>