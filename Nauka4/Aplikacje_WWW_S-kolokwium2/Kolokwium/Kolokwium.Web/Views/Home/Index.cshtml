@{
    ViewData["Title"] = "Strona Główna";
}

<div class="w3-center w3-padding-64">

    <hr style="max-width: 400px; margin: 20px auto;" />

    <div class="w3-margin-top">
        <a asp-controller="Author" asp-action="Index" class="w3-button w3-xlarge w3-green w3-round-large w3-margin">
            <i class="fa fa-users"></i> Zarządzaj Autorami
        </a>
        <br />
        <a asp-controller="Book" asp-action="Index" class="w3-button w3-xlarge w3-blue w3-round-large w3-margin">
            <i class="fa fa-car"></i> Zarządzaj Ksiazkami
        </a>
        <br />
        <a asp-controller="Publisher" asp-action="Index" class="w3-button w3-xlarge w3-blue w3-round-large w3-margin">
            <i class="fa fa-car"></i> Zarządzaj Wydawcami
        </a>
    </div>
</div>
