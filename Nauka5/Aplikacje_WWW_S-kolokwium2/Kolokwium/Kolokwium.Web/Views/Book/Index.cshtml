@model List<Kolokwium.Web.ViewModels.Book.IndexBookViewModel>

@{
    ViewData["Title"] = "Lista Książek";
}

<div class="w3-container w3-margin-top">
    <h2><i class="fa fa-book"></i> Zasoby Biblioteczne</h2>

    <p>
        <a asp-action="Create" class="w3-button w3-green w3-round"><i class="fa fa-plus"></i> Dodaj nową książkę</a>
    </p>

    <table class="w3-table-all w3-card-4 w3-hoverable">
        <thead>
            <tr class="w3-teal">
                <th>Tytuł</th>
                <th>Wydawca</th>
                <th>Status</th>
                <th class="w3-center">Akcje</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="w3-center w3-text-grey">Brak książek w katalogu.</td>
                </tr>
            }
            @foreach (var book in Model)
            {
                <tr>
                    <td><b>@book.Title</b></td>
                    <td>@book.PublisherName</td>
                    <td>
                        @{
                            var tagClass = book.Status == "Dostępna" ? "w3-green" :
                            book.Status == "Wypożyczona" ? "w3-orange" : "w3-red";
                        }
                        <span class="w3-tag @tagClass w3-round">@book.Status</span>
                    </td>
                    <td class="w3-center">
                        <a asp-action="Details" asp-route-id="@book.Id" class="w3-button w3-small w3-teal w3-round"><i class="fa fa-search"></i> Szczegóły</a>
                        <a asp-action="Edit" asp-route-id="@book.Id" class="w3-button w3-small w3-amber w3-round"><i class="fa fa-edit"></i> Edytuj</a>
                        <a asp-action="Delete" asp-route-id="@book.Id" class="w3-button w3-small w3-red w3-round"><i class="fa fa-trash"></i> Usuń</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>