@model SchoolRegister.ViewModels.VM.AddOrUpdateGroupVm

@{
    ViewData["Title"] = $"{@ViewBag.ActionType} Group";
}

<h1>@ViewData["Title"]</h1>

<h4>AddOrUpdateGroupVm</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddOrUpdateGroup">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                
                @if(@ViewBag.ActionType == "Edit")
                {
                    <label asp-for="Id" class="control-label"></label>
                    <input asp-for="Id" class="form-control" />
                }else
                {
                    <input type="hidden" asp-for="Id" class="form-control" />
                }
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="@ViewBag.ActionType" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
