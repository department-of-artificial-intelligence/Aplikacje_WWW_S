@model SchoolRegister.ViewModels.VM.AttachDetachSubjectGroupVm

@{
    ViewData["Title"] = "AttachSubjectToGroup";
}

<h1>AttachSubjectToGroup</h1>

<h4>AttachDetachSubjectGroupVm</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AttachSubjectToGroup">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            @if(ViewBag.ActionType == "SubjectId")
            {
                <div class="form-group">
                    <label class="control-label">Subject</label>
                    @*<input type="hidden" asp-for="SubjectId" />*@
                    <select asp-for="GroupId" class="form-control" asp-items="@ViewBag.GroupsSelectList"></select>
                    <span asp-validation-for="GroupId" class="text-danger"></span>
                </div>
            }
            @if(@ViewBag.ActionType == "GroupId")
            {
                <div class="form-group">
                    <label class="control-label">Subject</label>
                    @*<input type="hidden" asp-for="GroupId" />*@
                    <select asp-for="SubjectId" class="form-control" asp-items="@ViewBag.SubjectsSelectList"></select>
                    <span asp-validation-for="SubjectId" class="text-danger"></span>
                </div>
            }
            <div class="form-group">
                <input type="submit" value="Attach subject" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
