@model SchoolRegister.ViewModels.VM.AttachDetachSubjectGroupVm

@{
    ViewData["Title"] = "DetachSubjectFromGroup";
}

<h1>DetachSubjectFromGroup</h1>

<h4>AttachDetachSubjectGroupVm</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="DetachSubjectFromGroup">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if(ViewBag.ActionType == "GroupId")
            {
                <div class="form-group">
                    <label asp-for="GroupId" class="control-label"></label>
                    <input type="hidden" asp-for="GroupId" class="form-control" />
                    <select asp-items="@ViewBag.SubjectsSelectList" asp-for="SubjectId"></select>
                    <span asp-validation-for="GroupId" class="text-danger"></span>
                </div>
            }

            @if(ViewBag.ActionType == "SubjectId")
            {
                <div class="form-group">
                    <label class="control-label">Group</label>
                    <input type="hidden" asp-for="SubjectId" class="form-control" />
                    <select asp-items="@ViewBag.GroupsSelectList" asp-for="GroupId"></select>
                    <span asp-validation-for="SubjectId" class="text-danger"></span>
                </div>
            }
            <div class="form-group">
                <input type="submit" value="Detach" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
