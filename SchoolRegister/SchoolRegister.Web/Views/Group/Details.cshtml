@model SchoolRegister.ViewModels.VM.GroupVm

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Group: @Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Students)
        </dt>
        <dd class = "col-sm-10">
            @foreach(var s in Model.Students)
            {
                <p>@s.FirstName @s.LastName</p>
            }
        </dd>
        <hr />
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Subjects)
        </dt>
        <dd class = "col-sm-10">
            @foreach(var s in Model.Subjects)
            {
                <p>@s.Name</p>
            }
        </dd>
        <hr />
    </dl>
</div>
<div>
    <a asp-action="AttachStudentToGroup" asp-route-id="@Model.Id">Add student</a> |
    <a asp-action="Index">Back to List</a>
</div>
