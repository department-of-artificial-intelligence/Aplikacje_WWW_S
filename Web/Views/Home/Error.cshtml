@model Web.ViewModels.ErrorViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="w3-panel w3-card-4 w3-padding w3-red">
    <h2>Wystąpił błąd</h2>
    <p>Wystąpił nieoczekiwany błąd. Skontaktuj się z administratorem lub spróbuj ponownie później.</p>
    
    @if (Model?.ShowDetails == true && Model.Exception != null)
    {
        <hr />
        <h4>Szczegóły (tylko środowisko deweloperskie)</h4>
        <pre style="white-space:pre-wrap">@Model.Exception</pre>

        @if (Model?.ShowRequestId == true)
        {
            <p><strong>RequestId:</strong>@Model.RequestId</p>
        }
    }
</div>