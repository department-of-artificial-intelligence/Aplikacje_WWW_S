@model IEnumerable<Kolokwium.ViewModel.VM.ScreeningVm>

@{
    ViewData["Title"] = "Lista Seansów";
}

<h2>Lista Seansów</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj Nowy Seans</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.MovieTitle)</th>
            <th>@Html.DisplayNameFor(model => model.StartTime)</th>
            <th>@Html.DisplayNameFor(model => model.CinemaName)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.MovieTitle)</td>
                <td>@Html.DisplayFor(modelItem => item.StartTime)</td>
                <td>@Html.DisplayFor(modelItem => item.CinemaName)</td>
            </tr>
        }
    </tbody>
</table>